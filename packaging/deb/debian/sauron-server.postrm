#!/bin/sh
set -e

#DEBHELPER#

# Rebuild the linker cache after the vendored libduckdb is removed, mirroring the
# /sbin/ldconfig in the RPM's %postun server.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    ldconfig || :
fi

if [ "$1" = "purge" ]; then
    # secret.env is generated by the postinst, so it is not a dpkg conffile and
    # dpkg will not clean it up. The RPM declares it %ghost for the same reason.
    rm -f /etc/sauron/secret.env
fi
