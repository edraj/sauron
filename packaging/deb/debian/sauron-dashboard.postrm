#!/bin/sh
set -e

# config.js is generated by the postinst, not shipped, so dpkg does not own it and
# will not remove it. The RPM declares it %ghost for the same reason. Removed on
# `remove` rather than only on `purge`: it is generated output, not configuration,
# and the template it is generated from has just gone away with the package.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /usr/share/sauron/dashboard/config.js
    rmdir --ignore-fail-on-non-empty /usr/share/sauron/dashboard /usr/share/sauron 2>/dev/null || :
fi

#DEBHELPER#
