#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    # dpkg removes the conffiles it owns; this only clears what is left behind
    # (an empty directory, or files an operator added). --ignore-fail-on-non-empty
    # so an operator's own drop-in never turns a purge into a failure.
    rmdir --ignore-fail-on-non-empty /etc/sauron 2>/dev/null || :
    rmdir --ignore-fail-on-non-empty /var/lib/sauron/cold /var/lib/sauron 2>/dev/null || :
fi

# The `sauron` system account is deliberately NOT deleted on purge. Debian Policy
# permits leaving system users behind, and removing it would orphan the ownership
# of anything the operator kept -- cold-tier Parquet under /var/lib/sauron above
# all, which a purge intentionally does not delete when it is non-empty. The RPM's
# sysusers-created account behaves the same way.

#DEBHELPER#
