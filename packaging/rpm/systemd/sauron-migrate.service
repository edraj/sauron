[Unit]
Description=Sauron database migrations (one-shot)
Documentation=file:///usr/share/doc/sauron-server/SETUP.md
After=network-online.target postgresql.service
Wants=network-online.target
# NOTE: postgresql.service is ordering ONLY — deliberately no Wants= on it, so a
# host with a remote or containerised Postgres (where that unit does not exist)
# is unaffected. After=/Wants= naming a nonexistent unit is not an error.

[Service]
Type=oneshot
User=sauron
Group=sauron
EnvironmentFile=/etc/sauron/sauron.env
ExecStart=/usr/bin/sauron-migrate
# Deliberately NO RemainAfterExit=. The unit must RE-RUN on every daemon start,
# because that is the whole mechanism by which an upgrade cannot leave new
# binaries on an old schema. RemainAfterExit=yes would leave it active(exited)
# and therefore "already satisfied", so it would run about once per boot and the
# stale-schema hole this unit exists to close would reopen. A no-op run costs
# ~30 ms (measured, 46 migrations already applied), so there is nothing to save.
#
# OPERATOR WARNING, and a correction to an earlier round of notes: all six
# daemons carry Requires=sauron-migrate.service, and Requires= propagates STOP.
# `systemctl stop sauron-migrate` therefore takes down all six daemons — and it
# does so with RemainAfterExit unset, i.e. as shipped. Measured on Fedora 44 /
# systemd 259: with After= only the daemon survives; with Requires= the daemon
# stops, whether RemainAfterExit is yes or no. An earlier round on systemd
# 252/256 recorded the RemainAfterExit=no case as a harmless no-op — do not rely
# on that. To stop Sauron, stop the daemons by name, never this unit.
#
# Infinity is deliberate, and it REPLACED an earlier TimeoutStartSec=300.
#
# The two phases of this unit want opposite bounds, and the cap can only be
# placed on the wrong one. The CONNECT phase is already hard-bounded inside
# the binary (5s per probe attempt against a MIGRATE_WAIT_SECS deadline,
# default 120s — see run_pending_migrations_waiting), so an unreachable
# Postgres fails this unit, and every dependent start job with it, in about
# two minutes with no help from systemd. The EXECUTION phase is unbounded on
# purpose: schema rewrites legitimately run for tens of minutes (migration
# 0073 copies the whole sessions table and rebuilds 11 indexes), and a
# timeout here kills them mid-transaction — safe but wasted, and the unit can
# then NEVER succeed on a real dataset. Hit live: a production upgrade looped
# on "start operation timed out" at exactly 300s until this line changed.
# A migration that is genuinely stuck shows up in pg_stat_activity as a lock
# wait; that is the operator's signal, not a timer's guess.
TimeoutStartSec=infinity

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# No [Install] section — this unit is static and is pulled in by the daemons'
# Requires=. It is intentionally absent from the shipped systemd preset for the
# same reason: `preset` cannot enable a unit that has no [Install].
