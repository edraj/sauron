[Unit]
Description=Sauron alert evaluator
Documentation=file:///usr/share/doc/sauron-server/SETUP.md
# Requires= is what actually pulls the migrator into the transaction. `After=`
# alone is PURE ORDERING — it only says "if both units are already being
# started, run sauron-migrate first"; it never causes it to be started. For a
# long time these units carried only the After= line below, so migrations
# simply never ran on `dnf upgrade` and new binaries came up against an old
# schema, scattering 500s. Do NOT "simplify" this back to After= on its own.
#
# Do not weaken it to Wants= either: with Wants=, a FAILED migration still lets
# this daemon start against the stale schema, which is precisely the bug being
# fixed. The trade is deliberate and documented in SETUP.md section 11 — if
# sauron-migrate fails, this unit stays down until the DB is fixed and it is
# started again.
#
# sauron-migrate has no RemainAfterExit, so it re-runs on every start/restart of
# this unit; a no-op run was measured at ~30 ms.
Requires=sauron-migrate.service
After=network-online.target sauron-migrate.service
Wants=network-online.target

[Service]
Type=exec
User=sauron
Group=sauron
EnvironmentFile=/etc/sauron/sauron.env
EnvironmentFile=-/etc/sauron/alerts.env
# NOTIFY_SECRET_KEY lives here and is REQUIRED — this unit refuses to start
# without it. It must be byte-identical to the API's and the monitor's, or the
# channels the others wrote cannot be decrypted. %post generates it on install
# and backfills it from JWT_SECRET on upgrade (that is the key older builds
# actually encrypted with).
EnvironmentFile=/etc/sauron/secret.env
ExecStart=/usr/bin/sauron-alerts
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=sauron
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
