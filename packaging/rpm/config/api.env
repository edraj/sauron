# sauron-api — dashboard JWT API (listens on API_PORT).
API_PORT=8080

# Comma-separated browser origins allowed by CORS (where the dashboard is served).
CORS_ALLOWED_ORIGINS=http://localhost

# Token lifetimes (seconds).
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000

# Honour X-Forwarded-For / X-Real-IP when applying the per-IP auth limiters.
# The shipped nginx config serves only the dashboard's static files and does not
# proxy :8080, so the default is off and the limiters see the real peer address.
# If you DO put a reverse proxy in front, set this to true — otherwise every
# request appears to come from the proxy and the limits (10 registrations/hour,
# 60 logins/min) apply to the whole deployment rather than per client.
# Only enable behind a proxy that overwrites the header; it is caller-controlled.
API_TRUST_FORWARDED_HEADERS=false

# Cold-tier Parquet path (read for cross-tier queries).
TIER_COLD_PATH=/var/lib/sauron/cold

# Symbolication (source maps / debug files).
SYMBOLS_CACHE_MB=256
# SYMBOLS_REDIS_URL=redis://127.0.0.1:6379/1
