# sauron-tier — hot/cold Parquet tiering.
#
# TIER_HOT_DAYS is NOT declared here any more; it moved to sauron.env because
# sauron-inspector and sauron-api derive the same boundary and this unit is the
# only one that loads this file. See sauron.env, and SETUP.md section 11 for the
# upgrade step (%config(noreplace) keeps YOUR old copy of this file).
TIER_GRANULARITY=day
TIER_COLD_PATH=/var/lib/sauron/cold
TIER_DROP_LAG_HOURS=24
TIER_TICK_SECS=3600
TIER_PARTITION_AHEAD=7

# DuckDB memory ceiling for THIS unit, in MB (default 512 when unset).
#
# Deliberately higher than the default: the ceiling exists to stop sauron-api,
# which opens one engine per concurrent cold read, from OOMing under many
# readers. sauron-tier opens one at a time and streams a whole partition
# through it, so it needs real headroom -- a wide table (error_events carries
# stack traces and payloads) fails at 512 MB with "failed to pin block".
DUCKDB_MEMORY_MB=2048

# Cap on DuckDB's temp spill for THIS unit, in MB (default 10240 when unset).
#
# DuckDB's own default is 90% of the free space where it spills -- by default
# /var/lib/sauron/.tmp, usually the same disk as Postgres -- so an export that
# spills hard can fill that disk and take Postgres down. With a cap the export
# fails instead and is retried in one-hour windows, which need far less.
DUCKDB_MAX_TEMP_MB=10240

# Disk-pressure guard, checked on the TIER_COLD_PATH filesystem every cycle.
#
# Below TIER_DISK_WARN_PCT free, each cycle logs a warning. Below
# TIER_DISK_EMERGENCY_PCT free, that cycle tiers partitions older than
# TIER_EMERGENCY_HOT_DAYS (if that is shorter than the normal rotation age) and
# skips TIER_DROP_LAG_HOURS, so verified partitions leave Postgres sooner. A
# drop still requires every row to be in Parquet first. 0 disables emergency
# mode.
TIER_DISK_WARN_PCT=15
TIER_DISK_EMERGENCY_PCT=10
TIER_EMERGENCY_HOT_DAYS=3
