# sauron-tier — hot/cold Parquet tiering.
#
# TIER_HOT_DAYS is NOT declared here any more; it moved to sauron.env because
# sauron-inspector and sauron-api derive the same boundary and this unit is the
# only one that loads this file. See sauron.env, and SETUP.md section 11 for the
# upgrade step (%config(noreplace) keeps YOUR old copy of this file).
TIER_GRANULARITY=day
TIER_COLD_PATH=/var/lib/sauron/cold
TIER_DROP_LAG_HOURS=24
TIER_TICK_SECS=3600
TIER_PARTITION_AHEAD=7

# DuckDB memory ceiling for THIS unit, in MB (default 512 when unset).
#
# Deliberately higher than the default: the ceiling exists to stop sauron-api,
# which opens one engine per concurrent cold read, from OOMing under many
# readers. sauron-tier opens one at a time and streams a whole partition
# through it, so it needs real headroom -- a wide table (error_events carries
# stack traces and payloads) fails at 512 MB with "failed to pin block".
DUCKDB_MEMORY_MB=2048
