# sauron-alerts — polling evaluator for metric-based alert rules.
#
# Monitor up/down alerts fire inline from sauron-monitor; THIS service is what
# evaluates error spike/threshold, event threshold, and latency rules. Without
# it running, those rules can be created in the dashboard but never fire.

# How often to evaluate every enabled rule. Clamped to 5..3600 seconds.
ALERTS_TICK_SECS=30
# Per-delivery HTTP/SMTP timeout, milliseconds.
ALERTS_DELIVER_TIMEOUT_MS=10000
# Set true ONLY to allow delivery to private/internal addresses (SSRF guard) —
# e.g. an internal Slack-compatible endpoint or an SMTP relay on the LAN.
ALERTS_ALLOW_PRIVATE=false
