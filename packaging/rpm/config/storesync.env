# sauron-storesync — pulls daily install/uninstall counts from Google Play and
# the Apple App Store.
#
# Store reports are DAILY and land one to three days late, so syncing more often
# than a few times a day just re-fetches the same numbers.
STORE_SYNC_INTERVAL_SECS=21600
STORE_SYNC_MAX_CONCURRENCY=8
# How far back a connection's FIRST sync reaches. Later syncs use a short
# window, because both stores restate only the most recent few days.
STORE_BACKFILL_DAYS=90
