# sauron-ingest — SDK edge + worker pool (listens on INGEST_PORT).
INGEST_PORT=8081
WORKER_CONCURRENCY=4
INGEST_RATE_LIMIT_PER_MIN=6000
INGEST_MAX_BODY_BYTES=1048576

# Honour X-Forwarded-For / X-Real-IP for the client IP recorded on each event.
# The shipped nginx config only serves the dashboard's static files — it does
# NOT proxy this service — so the default is off and :8081 is reached directly.
# While off, client IPs are stored as NULL rather than taken from a header any
# caller could set. Turn this on ONLY once a proxy you control terminates
# ingest traffic and overwrites the header.
INGEST_TRUST_FORWARDED_HEADERS=false

# Ingest-path symbolication time box (ms).
SYMBOLS_INGEST_TIMEOUT_MS=150
# SYMBOLS_REDIS_URL=redis://127.0.0.1:6379/1
