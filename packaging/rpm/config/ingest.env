# sauron-ingest — SDK edge + worker pool (listens on INGEST_PORT).
#
# INGEST_PORT stays declared: it is a topology choice, not a tuned value, and
# SETUP.md section 8's firewall step and the metrics default (INGEST_PORT + 10000)
# both reference this number. The knobs below it were pinned to their own code
# defaults, which is the drift shape that let WORKER_CONCURRENCY=4 outlive the
# changelog announcing 8 — a literal here wins forever, including after a retune.
# Verified equal to sauron-core/src/config.rs before commenting out:
# INGEST_RATE_LIMIT_PER_MIN 6000 (config.rs:690), INGEST_MAX_BODY_BYTES 1048576
# (:691), SYMBOLS_INGEST_TIMEOUT_MS 150 (:720). So this is behaviour-neutral —
# a fresh install gets the same numbers from the binary.
INGEST_PORT=8081
#
# Envelopes accepted per app per minute, default 6000. Uncomment to raise (the
# troubleshooting table points here for ingest 429s).
# INGEST_RATE_LIMIT_PER_MIN=
#
# Largest accepted envelope body in bytes, default 1048576 (1 MiB).
# INGEST_MAX_BODY_BYTES=

# WORKER_CONCURRENCY is NOT declared here any more. It was pinned to 4, which
# silently outranked the retuned default of 8 that the 1.3.0 changelog
# announced — nothing logs the effective worker count, so the pin was invisible
# on a running host. The number now lives only in sauron-core/src/config.rs.
# See SETUP.md section 11 for the upgrade step (%config(noreplace) keeps YOUR
# old copy of this file, stale pin included).
#
# Uncomment ONLY to override. If you raise it above 8, raise INGEST_DB_POOL to
# match or the extra workers just queue on connection checkout and buy nothing.
# Do not raise it without also sweeping INGEST_BATCH_SIZE: at a batch of 50,
# going from 4 workers to 16 measured 22% SLOWER, not faster.
# WORKER_CONCURRENCY=
#
# Postgres pool for the worker pool, default 8. Must stay >= WORKER_CONCURRENCY.
# Left unset here for the same reason: the default lives in
# sauron-ingest/src/main.rs, not in this file.
# INGEST_DB_POOL=

# Honour X-Forwarded-For / X-Real-IP for the client IP recorded on each event.
# The shipped nginx config only serves the dashboard's static files — it does
# NOT proxy this service — so the default is off and :8081 is reached directly.
# While off, client IPs are stored as NULL rather than taken from a header any
# caller could set. Turn this on ONLY once a proxy you control terminates
# ingest traffic and overwrites the header.
INGEST_TRUST_FORWARDED_HEADERS=false

# Accounting counters (`GET /metrics`), on their OWN loopback listener.
#
# Left unset: the default is 127.0.0.1:<INGEST_PORT + 10000>, i.e. 127.0.0.1:18081
# here. Deliberately not a route on INGEST_PORT — SETUP.md section 8 tells you to
# open that port to the internet for SDKs, and these counters are per-deployment
# event volumes. Set `off` to disable, or host:port to move it. A listener that
# cannot bind logs a warning and ingest keeps running without the endpoint, so
# grep journalctl for `metrics listening` before assuming it is up.
# INGEST_METRICS_ADDR=
#
# How often the Redis-side stream gauges are refreshed, in seconds (default 15).
# Sampled on a timer rather than per scrape because XINFO STREAM echoes the
# first and last entry WITH their payloads — measured at 3941 reply bytes for a
# stream of 1783-byte entries. `0` serves the counters without the gauges.
# INGEST_METRICS_SAMPLE_SECS=

# Ingest-path symbolication time box (ms), default 150. Left unset for the same
# reason as the knobs at the top of this file.
# SYMBOLS_INGEST_TIMEOUT_MS=
# SYMBOLS_REDIS_URL=redis://127.0.0.1:6379/1
