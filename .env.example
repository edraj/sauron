# Copy to `.env` and adjust. Used by docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=sauron
POSTGRES_PASSWORD=sauron
POSTGRES_DB=sauron

# --- Auth ---
# CHANGE THIS. Any long random string (>=32 chars); api, monitor and alerts all
# refuse to start without it. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-000000000000

# --- CORS / URLs ---
# Origin the dashboard is served from (used for API CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# API base URL as seen from the user's BROWSER (host-published port, not the compose network).
API_BASE_URL=http://localhost:8080

# --- Logging ---
RUST_LOG=info,sauron=debug

# --- uptime monitor (sauron-monitor) ---
MONITOR_TICK_MS=1000
MONITOR_BATCH=100
MONITOR_MAX_CONCURRENCY=50
MONITOR_CHECK_RETENTION_DAYS=30
# Set true only for internal self-monitoring of private addresses.
MONITOR_SSRF_ALLOW_PRIVATE=false

# --- alerting (sauron-alerts) ---
# Encryption key for stored channel secrets (Slack URLs, SMTP passwords, ...).
# Leave unset to derive it from JWT_SECRET — but then ROTATING JWT_SECRET makes
# every stored channel secret undecryptable. Set it explicitly to decouple them.
# NOTIFY_SECRET_KEY=
# How often metric rules are evaluated (clamped to 5..3600).
ALERTS_TICK_SECS=30
ALERTS_DELIVER_TIMEOUT_MS=10000
# Set true only to deliver to private/internal addresses (SSRF guard), e.g. an
# internal webhook or LAN SMTP relay.
ALERTS_ALLOW_PRIVATE=false

# --- reverse proxy ---
# Honour X-Forwarded-For / X-Real-IP. Enable ONLY behind a proxy you control
# that overwrites the header; it is client-controlled otherwise.
#
# While INGEST_* is false, client IPs are recorded as NULL rather than spoofable.
# While API_* is false and a proxy IS in front, every request looks like it came
# from the proxy, so the per-IP auth limits (10 registrations/hour, 60 logins
# /min) apply to the whole deployment instead of per client.
INGEST_TRUST_FORWARDED_HEADERS=false
API_TRUST_FORWARDED_HEADERS=false

# --- hot/cold tiering (sauron-tier) ---
TIER_HOT_DAYS=30
TIER_GRANULARITY=day
TIER_DROP_LAG_HOURS=24
TIER_TICK_SECS=3600
TIER_PARTITION_AHEAD=7
# Cold-storage path is a FIXED in-container path set by docker-compose (/cold);
# not read from this env file. Shown here for reference.
# TIER_COLD_PATH=/cold
