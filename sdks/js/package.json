{
  "name": "@edraj/sauron-browser",
  "version": "1.5.0",
  "description": "Sauron browser SDK: automatic error reporting + product analytics for the web.",
  "homepage": "https://github.com/edraj/sauron/tree/main/sdks/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edraj/sauron.git",
    "directory": "sdks/js"
  },
  "bugs": {
    "url": "https://github.com/edraj/sauron/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sauron",
    "error-tracking",
    "analytics",
    "observability",
    "monitoring",
    "sdk",
    "browser"
  ],
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  }
}
