{
  "name": "@edraj/sauron-node",
  "version": "1.5.0",
  "description": "Sauron server-side Node/TypeScript SDK: product-analytics events + exception capture for Node backends.",
  "homepage": "https://github.com/edraj/sauron/tree/main/sdks/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edraj/sauron.git",
    "directory": "sdks/node"
  },
  "bugs": {
    "url": "https://github.com/edraj/sauron/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sauron",
    "error-tracking",
    "analytics",
    "observability",
    "monitoring",
    "sdk",
    "node",
    "server"
  ],
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  }
}
